# Copy to .env — .env is gitignored and never committed.

# --- Summary model -----------------------------------------------------------
# Everything here is optional. With no key at all, the report still works: the
# closing paragraph falls back to a deterministic one built from your scores.
#
# Set one key and Blundr picks that provider on its own. Set LLM_PROVIDER only
# to override that choice, or to use Ollama, which has no key to detect.

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# anthropic | openai | ollama. Unset = whichever key above is present.
# LLM_PROVIDER=

# Unset = that provider's default (claude-haiku-4-5, gpt-4o-mini, llama3.2).
# SUMMARY_MODEL=

# Any OpenAI-compatible endpoint — Groq, OpenRouter, Together, Gemini's compat
# layer, LM Studio, vLLM. Use it with LLM_PROVIDER=openai and that service's key.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# OLLAMA_HOST=http://localhost:11434
# LLM_TIMEOUT_S=120

# Ceiling on paid LLM calls per rolling 24h; past it the summary falls back.
SUMMARY_DAILY_BUDGET=200

# --- Chess.com ---------------------------------------------------------------
# Chess.com asks for a contact address so they can reach you about traffic from
# your instance. Please put your own here rather than leaving the placeholder.
CHESS_COM_CONTACT=you@example.com

# --- Engine ------------------------------------------------------------------
# Lower depth is faster and less precise (PRD §12).
STOCKFISH_PATH=stockfish
ENGINE_DEPTH=12
ENGINE_THREADS=2
ENGINE_HASH_MB=128
ENGINE_TIMEOUT_S=300

ALLOWED_ORIGINS=http://localhost:5173

# --- Limits ------------------------------------------------------------------
# Sized for one person on their own machine — a runaway-loop backstop, not a
# ration. Lower them a lot before putting an instance on the open internet.
MAX_CONCURRENT_ANALYSES=1
MAX_QUEUED_ANALYSES=8
RATE_LIMIT_ANALYZE=50
RATE_LIMIT_ELIGIBILITY=200
# Set only when a proxy that overwrites X-Forwarded-For sits in front.
# Otherwise a caller can forge an IP per request.
TRUST_PROXY_HEADER=false
