# Copy to .env — .env is gitignored and never committed.

# Without this the report summary falls back to a deterministic paragraph.
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-opus-5

# Chess.com returns 403 without a real contact address in the User-Agent.
CHESS_COM_CONTACT=you@example.com

# Engine. Lower depth is faster and less precise (PRD §12).
STOCKFISH_PATH=stockfish
ENGINE_DEPTH=12
ENGINE_THREADS=2
ENGINE_HASH_MB=128
ENGINE_TIMEOUT_S=300

ALLOWED_ORIGINS=http://localhost:5173
