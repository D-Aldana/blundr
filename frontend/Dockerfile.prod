# Production image: build the static bundle, then serve it from Caddy, which
# also terminates TLS and proxies /api to the backend. The dev Dockerfile runs
# the Vite dev server instead, which is not for public use.
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Same-origin, so no domain is baked in — Caddy routes /api to the backend.
ENV VITE_API_BASE=/api
RUN npm run build

FROM caddy:2-alpine

COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv

EXPOSE 80 443
